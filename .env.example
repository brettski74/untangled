# Example runtime env for Rocky / `make deploy-pull` (do not commit real secrets).
# Actions writes an equivalent file to the host from Environment secrets.
# Local: copy to `.env` when exercising `make deploy-pull` (gitignored).
# `make up` does not require this file (Compose defaults cover local-dev).

POSTGRES_USER=untangled
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=untangled

DATABASE_URL=postgresql://untangled:replace-me@postgres:5432/untangled

UNTANGLED_JWT_SECRET=replace-me-with-a-long-random-secret
UNTANGLED_ACCESS_TOKEN_TTL_SECONDS=900
UNTANGLED_REFRESH_TOKEN_TTL_SECONDS=604800

UNTANGLED_SESSION_SECRET=replace-me-with-a-long-random-secret
# true behind HTTPS reverse proxy (typical for untangled9.dataphobe.com).
UNTANGLED_COOKIE_SECURE=true
UNTANGLED_API_BASE_URL=http://api:8000

# Rocky / reverse-proxy hosts typically publish web on 3000 (local make up defaults to 5173).
UNTANGLED_WEB_HOST_PORT=3000
# UNTANGLED_API_HOST_PORT=8000
# UNTANGLED_POSTGRES_HOST_PORT=5432
